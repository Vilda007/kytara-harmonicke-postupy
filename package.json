{
  "name": "kytara-harmonicke-postupy",
  "version": "1.0.0",
  "description": "Harmonic (chord progression) cheat sheets for 12 major keys and 12 minor keys, plus a full 28-page book with music theory from zero. Built around the circle of fifths — interactive React app + generated HTML/PDF books.",
  "main": "index.js",
  "scripts": {
    "build:js": "esbuild src/app.jsx --bundle --minify --format=iife --outfile=app.v1.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i src/input.css -o app.v1.css --minify",
    "build": "npm run build:js && npm run build:css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vilda007/kytara-harmonicke-postupy.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Vilda007/kytara-harmonicke-postupy/issues"
  },
  "homepage": "https://github.com/Vilda007/kytara-harmonicke-postupy#readme",
  "dependencies": {
    "puppeteer": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  }
}
